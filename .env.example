# Database Configuration
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (BullMQ queues). Local infra publishes Redis on 127.0.0.1:6379.
# Production Docker: redis://redis_db:6379
REDIS_URL=redis://localhost:6379

# Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
INTERNAL_API_SECRET=

# Public App Configuration
# NEXT_PUBLIC_* is inlined at `next build` / `next dev` start — not at runtime.
# Production images must be built with these set (CI writes PRODUCTION_ENV_FILE to .env).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_REALTIME_URL=
# Base of every stored file URL: the web app's own file route, e.g. https://app.example.com/api/files
# The R2 bucket is private; /api/files checks the user, then redirects to a signed link.
CDN_URL=

# Mailer Configuration
MAIL_HOST=
MAIL_PORT=587
EMAIL=
PASSWORD=
# Optional From override (defaults to EMAIL)
# MAIL_FROM=

# Storage (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Riaya public phone number (E.164). Used as Twilio From for outbound callback
# when a pending AI appointment times out unanswered.
TWILIO_PHONE_NUMBER=

# LiveKit (test-call token endpoint). Same values as the voice service.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=riaya-agent

# Geoapify
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Provider for address suggestions and routing: "geoapify" or "google".
# Switch by changing this and restarting the web app. Google needs
# GOOGLE_PLACES_API_KEY with "Places API (New)" (and "Routes API") enabled and
# billing on.
GEO_PROVIDER=geoapify
# Provider for the voice agent's place search (the patient's location on a
# call). Follows GEO_PROVIDER when empty. Every Google request is logged.
GEO_SEARCH_PROVIDER=google
# Google Places
GOOGLE_PLACES_API_KEY=
PORT=50000

# Konnect.network (payment gateway)
KONNECT_API_KEY=
KONNECT_API_ENDPOINT=https://api.konnect.network/api/v2/
# receiverWalletId — find in Konnect dashboard > Settings > Wallet
KONNECT_WALLET_ID=

# Temporary fake Konnect gateway (local testing only).
# When true: checkout opens /dev/pay; success fires the real Konnect webhook.
# BILLING_DEV_BYPASS=true

# OpenRouter (AI chat + transcription)
OPENROUTER_API_KEY=your_key_here
# OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash-0731
