# Database Configuration
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (BullMQ queues). Local infra publishes Redis on 127.0.0.1:6379.
# Production Docker: redis://redis_db:6379
REDIS_URL=redis://localhost:6379

# Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
INTERNAL_API_SECRET=

# Public App Configuration
# NEXT_PUBLIC_* is inlined at `next build` / `next dev` start — not at runtime.
# Production images must be built with these set (CI writes PRODUCTION_ENV_FILE to .env).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_REALTIME_URL=
CDN_URL=

# Mailer Configuration
MAIL_HOST=
MAIL_PORT=587
EMAIL=
PASSWORD=
# Optional From override (defaults to EMAIL)
# MAIL_FROM=

# Storage (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Geoapify
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=
PORT=50000

# Konnect.network (payment gateway)
KONNECT_API_KEY=
KONNECT_API_ENDPOINT=https://api.konnect.network/api/v2/
# receiverWalletId — find in Konnect dashboard > Settings > Wallet
KONNECT_WALLET_ID=

# Temporary fake Konnect gateway (local testing only).
# When true: checkout opens /dev/pay; success fires the real Konnect webhook.
# BILLING_DEV_BYPASS=true

# Azure OpenAI / Foundry (AI chat — gpt-5-mini via Responses API)
# Use the v1 base URL, e.g.:
#   https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini

# Azure OpenAI transcription (gpt-transcribe — separate resource/keys)
AZURE_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_API_KEY=
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-transcribe
AZURE_TRANSCRIBE_API_VERSION=2025-03-01-preview
